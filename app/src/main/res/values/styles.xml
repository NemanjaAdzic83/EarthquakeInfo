<resources>

    <!-- Base application theme: Material 3, follows the system light / dark mode -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Buttons, switches, dialog buttons, focused fields -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/brand_teal</item>

        <!-- Screen background and its text -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_surface</item>

        <!-- Cards, dialogs and their text -->
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceContainerLow">@color/color_surface</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
    </style>

</resources>
