<?xml version="1.0" encoding="utf-8"?>
<!-- Details of one earthquake, shown in a panel that slides up from the bottom -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/details_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- The small grey bar at the top that shows the panel can be dragged -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Big magnitude circle + place -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/details_magnitude"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/magnitude_circle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                tools:text="6.5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/details_offset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="73 km WSW of" />

                <TextView
                    android:id="@+id/details_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Rumoi, Japan" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shown only when USGS flagged a possible tsunami -->
        <TextView
            android:id="@+id/details_tsunami"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/tsunami_background"
            android:padding="12dp"
            android:text="@string/details_tsunami"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Time -->
        <TextView
            style="@style/DetailsLabel"
            android:text="@string/details_time" />

        <TextView
            android:id="@+id/details_time"
            style="@style/DetailsValue"
            tools:text="Tuesday, 20 October 2026, 21:15" />

        <!-- Depth -->
        <TextView
            android:id="@+id/details_depth_label"
            style="@style/DetailsLabel"
            android:text="@string/details_depth" />

        <TextView
            android:id="@+id/details_depth"
            style="@style/DetailsValue"
            tools:text="10.0 km" />

        <!-- Coordinates -->
        <TextView
            android:id="@+id/details_coordinates_label"
            style="@style/DetailsLabel"
            android:text="@string/details_coordinates" />

        <TextView
            android:id="@+id/details_coordinates"
            style="@style/DetailsValue"
            tools:text="43.61° N, 141.18° E" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/details_show_on_map"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/details_show_on_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/details_open_usgs"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/details_open_usgs" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>