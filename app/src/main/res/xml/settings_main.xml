<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_title">

    <ListPreference
        android:defaultValue="@string/settings_order_by_default"
        android:entries="@array/settings_order_by_labels"
        android:entryValues="@array/settings_order_by_values"
        android:key="@string/settings_order_by_key"
        android:title="@string/settings_order_by_label"/>

    <SeekBarPreference
        android:defaultValue="@integer/setting_main_magnitude_default"
        android:key="@string/setting_min_magnitude_key"
        android:max="9"
        android:summary="@string/setting_min_magnitude_summary"
        android:title="@string/setting_min_magnitude_label"
        app:min="0"
        app:seekBarIncrement="1"
        app:showSeekBarValue="true"
        app:updatesContinuously="false"/>

</PreferenceScreen>